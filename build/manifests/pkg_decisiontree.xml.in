<?xml version="1.0" encoding="utf-8"?>
<extension type="package" version="5.0" method="upgrade">
	<name>Decision Tree (Component + Plugin)</name>
	<packagename>decisiontree</packagename>
	<version>@VERSION@</version>
	<creationDate>2026-05-05</creationDate>
	<author>Grant Hood</author>
	<license>GNU General Public License version 2 or later</license>
	<description>Decision Tree package installer</description>
	<scriptfile>pkg_decisiontree.php</scriptfile>

	<files>
		<file type="component" id="com_decisiontree">com_decisiontree-@VERSION@.zip</file>
		<file type="plugin" id="decisiontree" group="content">plg_content_decisiontree-@VERSION@.zip</file>
	</files>

	<updateservers>
		<server type="extension" priority="1" name="Decision Tree Package Update Server">
			https://raw.githubusercontent.com/gphood/Decision-Tree-Component/master/updates/pkg_decisiontree.xml
		</server>
	</updateservers>
</extension>
